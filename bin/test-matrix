#!/usr/bin/env bash
# Run RSpec (and optionally RuboCop) for one or many Ruby × Rails pairs via Docker.
#
# Examples:
#   bin/test-matrix                         # default: 3.3 × 7.1
#   bin/test-matrix 3.2 7.2                 # one pair
#   bin/test-matrix --all                   # full supported matrix
#   bin/test-matrix --rubocop 3.3 7.1       # rspec + rubocop
#   RAILS_VERSION=8.0 RUBY_VERSION=3.3 bin/test-matrix
set -euo pipefail

cd "$(dirname "$0")/.."

DEFAULT_RUBY=3.3
DEFAULT_RAILS=7.1

# Compatible pairs (mirrors .github/workflows/ci.yml)
ALL_PAIRS=(
  "3.1:7.0"
  "3.2:7.0"
  "3.3:7.0"
  "3.1:7.1"
  "3.2:7.1"
  "3.3:7.1"
  "3.2:7.2"
  "3.3:7.2"
  "3.2:8.0"
  "3.3:8.0"
)

RUN_RUBOCOP=0
RUN_ALL=0
PAIRS=()

usage() {
  sed -n '2,12p' "$0"
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage 0 ;;
    --all) RUN_ALL=1; shift ;;
    --rubocop) RUN_RUBOCOP=1; shift ;;
    -*)
      echo "Unknown option: $1" >&2
      usage 1
      ;;
    *)
      break
      ;;
  esac
done

if [[ "$RUN_ALL" -eq 1 ]]; then
  PAIRS=("${ALL_PAIRS[@]}")
elif [[ $# -ge 2 ]]; then
  PAIRS=("$1:$2")
elif [[ $# -eq 1 ]]; then
  echo "Provide both RUBY_VERSION and RAILS_VERSION, or use --all" >&2
  usage 1
else
  PAIRS=("${RUBY_VERSION:-$DEFAULT_RUBY}:${RAILS_VERSION:-$DEFAULT_RAILS}")
fi

failures=0
for pair in "${PAIRS[@]}"; do
  ruby_v="${pair%%:*}"
  rails_v="${pair##*:}"
  tag="rails-oidc_provider-test:${ruby_v}-rails${rails_v}"
  echo "============================================================"
  echo " Ruby ${ruby_v}  ×  Rails ${rails_v}"
  echo "============================================================"

  if ! docker build \
      --build-arg "RUBY_VERSION=${ruby_v}" \
      --build-arg "RAILS_VERSION=${rails_v}" \
      -t "$tag" \
      .; then
    echo "BUILD FAILED: ${pair}" >&2
    failures=$((failures + 1))
    continue
  fi

  if ! docker run --rm \
      -e OIDC_PROVIDER_KEY_PASSPHRASE=test-passphrase \
      -e APP_HOST=www.example.com \
      "$tag" bundle exec rspec; then
    echo "RSPEC FAILED: ${pair}" >&2
    failures=$((failures + 1))
    continue
  fi

  if [[ "$RUN_RUBOCOP" -eq 1 ]]; then
    if ! docker run --rm "$tag" bundle exec rubocop; then
      echo "RUBOCOP FAILED: ${pair}" >&2
      failures=$((failures + 1))
      continue
    fi
  fi

  echo "OK: ${pair}"
done

if [[ "$failures" -gt 0 ]]; then
  echo "${failures} pair(s) failed" >&2
  exit 1
fi

echo "All requested pairs passed."
